{
  "name": "cm-dropship",
  "version": "0.1.0",
  "description": "AliExpress/Alibaba -> Shopify dropshipping automation for Cameroon: import supplier links, price them in XAF, publish to Shopify, track supplier payouts and fulfilment.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\"",
    "webhooks:register": "node --no-warnings=ExperimentalWarning src/scripts/register-webhooks.js",
    "prices:sync": "node --no-warnings=ExperimentalWarning src/scripts/sync-prices.js",
    "fx:update": "node --no-warnings=ExperimentalWarning src/scripts/update-fx.js",
    "typecheck": "tsc -p tsconfig.json",
    "vercel-build": "echo \"no build step\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "express": "^5.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
