# ---- App ----
PORT=3000
# Public URL where Shopify can reach this app (ngrok / Cloudflare Tunnel / your VPS). No trailing slash.
APP_URL=https://your-public-host.example.com
# Password for the admin UI (HTTP Basic auth, user = admin). REQUIRED.
ADMIN_PASSWORD=change-me
# Where the SQLite database lives
DATABASE_PATH=./data/dropship.sqlite

# ---- Shopify (custom app in your store admin: Settings > Apps > Develop apps) ----
# Scopes needed: write_products, read_products, read_orders, write_orders,
#                write_merchant_managed_fulfillment_orders, read_merchant_managed_fulfillment_orders,
#                write_fulfillments, read_fulfillments, read_locations
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "API secret key" of the same custom app. Used to verify webhook signatures.
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07
# Publish products as ACTIVE immediately, or DRAFT so you can check them first in Shopify
SHOPIFY_DEFAULT_STATUS=ACTIVE

# ---- AliExpress Dropshipping API (optional but recommended; https://openservice.aliexpress.com) ----
# Without these, the app falls back to reading the public product page, which is less reliable.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
# Set to true ONLY after you have tested: when a Shopify order is paid the app will place
# the supplier order on AliExpress on your behalf (paid with your AliExpress payment method).
ALIEXPRESS_AUTO_ORDER=false

# ---- Automation ----
# Re-check supplier prices every N hours and update Shopify (0 = disabled, use `npm run prices:sync` manually)
PRICE_SYNC_INTERVAL_HOURS=0
